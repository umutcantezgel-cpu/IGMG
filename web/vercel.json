{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/api/wartung/loeschfristen",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/wartung/mail-ausgang",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/wartung/gebetszeiten-abgleich",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/wartung/dachverband-abgleich",
      "schedule": "0 4 * * *"
    }
  ]
}
