{
  "name": "igmg-wetzlar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-bau.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typen": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:abdeckung": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm typen && pnpm lint && pnpm test:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env drizzle/seeds/index.ts",
    "auth:schema": "node scripts/auth-schema.mjs",
    "schriften:kopieren": "node scripts/schriften-kopieren.mjs",
    "altcha:kopieren": "node scripts/altcha-kopieren.mjs",
    "verwaltung:einladen": "tsx --env-file-if-exists=.env scripts/einladen.ts",
    "quran:import": "tsx --env-file-if-exists=.env scripts/quran-import.ts",
    "inhalte:import": "tsx --conditions=react-server --env-file-if-exists=.env scripts/inhalte-import.ts",
    "lernapp:import": "tsx --conditions=react-server --env-file-if-exists=.env scripts/lernapp/import.ts",
    "lernapp:pruefen": "tsx --conditions=react-server scripts/lernapp/pruefen.ts",
    "inhalte:2026": "tsx --conditions=react-server --env-file-if-exists=.env scripts/inhalte-2026.ts",
    "geheimnisse:pruefen": "node scripts/geheimnis-pruefung.mjs --alles",
    "geheimnisse:erzeugen": "node scripts/geheimnisse-erzeugen.mjs",
    "startklar": "tsx --conditions=react-server --env-file-if-exists=.env scripts/startklar.ts",
    "release:check": "node scripts/release-check.mjs",
    "format": "prettier --write",
    "start:standalone": "node scripts/start-standalone.mjs",
    "db:bau-vorbereiten": "node scripts/bau-datenbank.mjs",
    "sprachen:pruefen": "node scripts/sprachen-pruefen.mjs",
    "messen": "node scripts/messen.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@better-auth/passkey": "1.7.7",
    "@date-fns/tz": "^1.5.0",
    "@huggingface/transformers": "4.3.0",
    "@react-email/render": "^2.1.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/static-renderer": "3.31.4",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "adhan": "4.4.6",
    "altcha": "^3.3.0",
    "altcha-lib": "^2.6.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "fastest-levenshtein": "1.0.16",
    "ical-generator": "^11.1.2",
    "idb": "8.0.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.1",
    "rrule": "2.8.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.2",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@better-auth/cli": "1.4.21",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "lighthouse": "13.5.0",
    "lint-staged": "^17.6.0",
    "otpauth": "^9.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "simple-git-hooks": {
    "pre-commit": "export PATH=\"$HOME/.local/bin:$PATH\" && cd web && pnpm exec lint-staged && node scripts/geheimnis-pruefung.mjs --staged",
    "pre-push": "cd web && node scripts/geheimnis-pruefung.mjs --push"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
