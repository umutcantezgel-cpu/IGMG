{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Erzeugt mit `pnpm lernapp:schemas` aus web/src/lib/lernapp/inhalt/schema.ts – nicht von Hand ändern.",
  "title": "Lern-App: Rahmenplan einer Zielsprache (rahmen/<sprache>.rahmen.json)",
  "type": "object",
  "properties": {
    "sprache": { "type": "string", "enum": ["de", "tr", "ar"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.]+)?$" },
    "stand": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hinweis": { "type": "string", "const": "orientiert am GER (Europarat 2001/2020)" },
    "quelle": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
    },
    "ausgangssprachen": { "minItems": 2, "maxItems": 2, "type": "array", "items": { "type": "string", "enum": ["de", "tr", "ar"] } },
    "grammatik": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(?:de|tr|ar)\\.g\\.[a-z0-9_-]+$" },
          "stufe": { "type": "string", "enum": ["a1", "a2", "b1", "b2", "c1"] },
          "titel": { "type": "string", "minLength": 1, "maxLength": 120 },
          "kurz": { "type": "string", "minLength": 1, "maxLength": 500 },
          "beispiele": { "maxItems": 10, "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "voraus": { "maxItems": 20, "type": "array", "items": { "type": "string", "maxLength": 80 } }
        },
        "required": ["id", "stufe", "titel", "kurz", "beispiele", "voraus"],
        "additionalProperties": false
      }
    },
    "wortfelder": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(?:de|tr|ar)\\.w\\.[a-z0-9_-]+$" },
          "titel": { "type": "string", "minLength": 1, "maxLength": 120 },
          "beispiele": { "maxItems": 40, "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
        },
        "required": ["id", "titel", "beispiele"],
        "additionalProperties": false
      }
    },
    "vorkurs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schluessel": { "type": "string", "pattern": "^(?:de|tr|ar)\\.v\\.l\\d{2}$" },
          "titel": { "type": "string", "minLength": 1, "maxLength": 120 },
          "ziel": { "type": "string", "minLength": 1, "maxLength": 400 },
          "inhalt": { "maxItems": 20, "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
          "fuer": { "minItems": 1, "maxItems": 2, "type": "array", "items": { "type": "string", "enum": ["de", "tr", "ar"] } }
        },
        "required": ["schluessel", "titel", "ziel", "inhalt", "fuer"],
        "additionalProperties": false
      }
    },
    "stufen": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stufe": { "type": "string", "enum": ["a1", "a2", "b1", "b2", "c1"] },
          "lemmaBudget": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "saetze": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "kannBeschreibungen": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "abdeckungZiel": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "einheiten": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "schluessel": { "type": "string", "maxLength": 120 },
                "titel": { "type": "string", "minLength": 1, "maxLength": 120 },
                "thema": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "kannBeschreibungen": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 300 }
                },
                "kommunikation": { "maxItems": 12, "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
                "grammatik": { "maxItems": 60, "type": "array", "items": { "type": "string", "maxLength": 80 } },
                "wortfelder": { "maxItems": 60, "type": "array", "items": { "type": "string", "maxLength": 80 } },
                "lemmaBudget": { "type": "integer", "minimum": 0, "maximum": 400 },
                "geschichte": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }] },
                "lesetext": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }] },
                "sprechen": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 600 }, { "type": "null" }] },
                "schreiben": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 600 }, { "type": "null" }] },
                "religionsbezugKandidaten": {
                  "maxItems": 40,
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(?:R-\\d{2}|F-(?:de|tr|ar)-\\d{2})$" }
                },
                "kinderGeeignet": { "type": "boolean" },
                "stationen": {
                  "minItems": 1,
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["lektion", "geschichte", "wiederholung", "pruefstein", "schrift", "schreiben", "sprechen"]
                  }
                }
              },
              "required": [
                "schluessel",
                "titel",
                "thema",
                "kannBeschreibungen",
                "kommunikation",
                "grammatik",
                "wortfelder",
                "lemmaBudget",
                "geschichte",
                "lesetext",
                "sprechen",
                "schreiben",
                "religionsbezugKandidaten",
                "kinderGeeignet",
                "stationen"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["stufe", "lemmaBudget", "saetze", "kannBeschreibungen", "abdeckungZiel", "einheiten"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sprache", "version", "stand", "hinweis", "quelle", "ausgangssprachen", "grammatik", "wortfelder", "vorkurs", "stufen"],
  "additionalProperties": false
}
