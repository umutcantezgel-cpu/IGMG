{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Erzeugt mit `pnpm lernapp:schemas` aus web/src/lib/lernapp/inhalt/schema.ts – nicht von Hand ändern.",
  "title": "Lern-App: Einheit des Wissenskurses (islam/<bereich>/<einheit>.json)",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "igmg-lernapp-islam" },
    "version": { "type": "number", "const": 1 },
    "status": { "default": "entwurf", "type": "string", "enum": ["entwurf", "automatisch_geprueft"] },
    "kurs": { "type": "string", "const": "islam" },
    "bereich": {
      "type": "string",
      "enum": ["akaid", "taharah", "salah", "sawm", "zakat", "hajj", "halal_haram", "akhlaq", "siyar", "grundwissen"]
    },
    "stufe": { "type": "string", "enum": ["grund", "aufbau", "vertiefung"] },
    "einheit": {
      "type": "object",
      "properties": {
        "schluessel": { "type": "string", "maxLength": 120 },
        "reihenfolge": { "type": "integer", "minimum": 1, "maximum": 999 },
        "thema": {
          "type": "object",
          "properties": {
            "de": { "type": "string", "minLength": 1, "maxLength": 300 },
            "tr": { "type": "string", "minLength": 1, "maxLength": 300 },
            "ar": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        "kannBeschreibungen": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "de": { "type": "string", "minLength": 1, "maxLength": 300 },
              "tr": { "type": "string", "minLength": 1, "maxLength": 300 },
              "ar": { "type": "string", "minLength": 1, "maxLength": 300 }
            },
            "additionalProperties": false
          }
        },
        "symbol": { "type": "string", "maxLength": 200 }
      },
      "required": ["schluessel", "reihenfolge", "thema"],
      "additionalProperties": false
    },
    "lektionen": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schluessel": { "type": "string", "maxLength": 120 },
          "titel": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kinderGeeignet": { "type": "boolean" },
          "aussagen": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "schluessel": { "type": "string", "maxLength": 120 },
                "text": { "type": "string", "minLength": 1, "maxLength": 800 },
                "meinung": { "type": "string", "enum": ["abu_hanifa", "abu_yusuf", "muhammad", "zufar", "fatwa"] },
                "strittig": { "default": false, "type": "boolean" },
                "kinderGeeignet": { "default": true, "type": "boolean" },
                "belege": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "werk": {
                        "type": "string",
                        "enum": [
                          "quduri",
                          "nur_al_idah",
                          "maraqi_al_falah",
                          "hidaya",
                          "ikhtiyar",
                          "radd_al_muhtar",
                          "fiqh_akbar",
                          "tahawiyya",
                          "nasafiyya"
                        ]
                      },
                      "kapitel": { "type": "string", "minLength": 1, "maxLength": 300 },
                      "ausgabe": { "type": "string", "minLength": 1, "maxLength": 300 },
                      "band": { "type": "integer", "minimum": 1, "maximum": 30 },
                      "seite": { "type": "integer", "minimum": 1, "maximum": 5000 },
                      "passage": { "type": "string", "pattern": "^[a-z_]+\\.ms\\d{1,5}$" },
                      "fundstelle": {
                        "type": "string",
                        "pattern": "^\\d{4}[A-Za-z]+\\.[A-Za-z]+\\.[A-Za-z0-9]+(?:-[a-z]{3}\\d)?(?:\\.[a-z]+)?#ms\\d{1,5}$"
                      },
                      "passageSha256Text": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "zitatVon": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "zitatBis": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "art": { "default": "sinngemaess", "type": "string", "enum": ["sinngemaess", "woertlich"] }
                    },
                    "required": ["werk", "kapitel", "ausgabe", "passage"],
                    "additionalProperties": false
                  }
                },
                "verweise": {
                  "default": [],
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "art": { "type": "string", "const": "koran" },
                          "stelle": { "type": "string", "pattern": "^\\d{1,3}:\\d{1,3}(?:-\\d{1,3})?$" }
                        },
                        "required": ["art", "stelle"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "art": { "type": "string", "const": "hadith" },
                          "sammlung": { "type": "string", "enum": ["bukhari"] },
                          "nummer": { "type": "integer", "minimum": 1, "maximum": 10000 }
                        },
                        "required": ["art", "sammlung", "nummer"],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "quelle": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                },
                "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
              },
              "required": ["schluessel", "text", "belege", "quelle", "lizenz"],
              "additionalProperties": false
            }
          },
          "aufgaben": {
            "default": [],
            "maxItems": 60,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "auswahl" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "frage": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "optionen": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                    },
                    "richtig": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "frage", "optionen", "richtig", "quelle", "lizenz"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "wahr_falsch" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "behauptung": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "richtig": { "type": "boolean" },
                    "begruendung": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "behauptung", "richtig", "begruendung", "quelle", "lizenz"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "zuordnen" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "anweisung": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "paare": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "links": { "type": "string", "minLength": 1, "maxLength": 120 },
                          "rechts": { "type": "string", "minLength": 1, "maxLength": 120 }
                        },
                        "required": ["links", "rechts"],
                        "additionalProperties": false
                      }
                    },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "anweisung", "paare", "quelle", "lizenz"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "reihenfolge" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "anweisung": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "schritte": {
                      "minItems": 2,
                      "maxItems": 10,
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                    },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "anweisung", "schritte", "quelle", "lizenz"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "luecke" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "text": { "type": "string", "minLength": 1, "maxLength": 400 },
                    "loesung": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "ablenker": {
                      "default": [],
                      "maxItems": 5,
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
                    },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "text", "loesung", "quelle", "lizenz"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "schluessel": { "type": "string", "maxLength": 120 },
                    "typ": { "type": "string", "const": "fallfrage" },
                    "aussage": { "type": "string", "maxLength": 120 },
                    "fall": { "type": "string", "minLength": 1, "maxLength": 600 },
                    "frage": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "optionen": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                    },
                    "richtig": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "quelle": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^(?:ki:[A-Za-z0-9._/:-]{1,180}|tatoeba:\\d{1,12}|kaikki:[A-Za-z0-9._:-]{1,120}|wiktionary:(?:en|de|tr):[^\\s:][^\\n\\r\\t]{0,150}|redaktion|test:[a-z0-9-]{1,60})$"
                    },
                    "lizenz": { "type": "string", "const": "CC-BY-SA-4.0" }
                  },
                  "required": ["schluessel", "typ", "aussage", "fall", "frage", "optionen", "richtig", "quelle", "lizenz"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["schluessel", "titel", "kinderGeeignet", "aussagen"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "kurs", "bereich", "stufe", "einheit", "lektionen"],
  "additionalProperties": false
}
