{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Erzeugt mit `pnpm lernapp:schemas` aus web/src/lib/lernapp/inhalt/schema.ts – nicht von Hand ändern.",
  "title": "Lern-App: Zielinhalt einer Einheit (sprache/<ziel>/<stufe>/<einheit>.json)",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "igmg-lernapp-sprache" },
    "version": { "type": "number", "const": 1 },
    "status": { "default": "entwurf", "type": "string", "enum": ["entwurf", "automatisch_geprueft"] },
    "kurs": { "type": "string", "enum": ["de", "tr", "ar"] },
    "stufe": { "type": "string", "enum": ["a1", "a2", "b1", "b2", "c1"] },
