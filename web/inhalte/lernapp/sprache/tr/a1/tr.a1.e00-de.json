      "ar": "دورة تمهيدية: الحروف والأصوات التركية"
    },
    "kannBeschreibungen": [
      {
        "de": "Ich kann das türkische Alphabet lesen und die Buchstaben ç, ğ, ı, İ, ö, ş und ü sicher erkennen.",
        "tr": "Türk alfabesini okuyabilir, ç, ğ, ı, İ, ö, ş ve ü harflerini tanıyabilirim.",
        "ar": "أستطيع قراءة الأبجدية التركية وأميّز الحروف ç وğ وı وİ وö وş وü."
      },
      {
        "de": "Ich kann helle und dunkle Vokale unterscheiden und erkennen, welche Endung zu einem Wort passt.",
        "tr": "İnce ve kalın ünlüleri ayırt edebilir, bir kelimeye hangi ekin uyduğunu anlayabilirim.",
        "ar": "أستطيع التمييز بين الأصوات الخفيفة والثقيلة، ومعرفة اللاحقة المناسبة للكلمة."
      }
    ],
