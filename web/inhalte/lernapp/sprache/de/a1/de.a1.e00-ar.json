    "thema": {
      "de": "Vorkurs: Lateinschrift",
      "tr": "Ön kurs: Latin yazısı",
      "ar": "دورة تمهيدية: الكتابة اللاتينية"
    },
    "kannBeschreibungen": [
      {
        "de": "Ich kann die 26 Buchstaben des lateinischen Alphabets erkennen, ihre Namen sagen und von links nach rechts lesen.",
        "tr": "Latin alfabesinin 26 harfini tanıyabilir, adlarını söyleyebilir ve soldan sağa okuyabilirim.",
        "ar": "أستطيع أن أتعرّف على حروف الأبجدية اللاتينية الستة والعشرين، وأن أقول أسماءها، وأن أقرأ من اليسار إلى اليمين."
      },
      {
        "de": "Ich kann Groß- und Kleinbuchstaben einander zuordnen und weiß, wann man im Deutschen großschreibt.",
        "tr": "Büyük ve küçük harfleri eşleştirebilir, Almancada ne zaman büyük harf kullanıldığını bilirim.",
        "ar": "أستطيع أن أربط بين الحروف الكبيرة والصغيرة، وأعرف متى يُكتب الحرف الكبير في الألمانية."
      },
      {
        "de": "Ich kann ä, ö, ü und ß lesen, aussprechen und von a, o, u und s unterscheiden.",
        "tr": "ä, ö, ü ve ß harflerini okuyabilir, söyleyebilir ve a, o, u ve s harflerinden ayırt edebilirim.",
        "ar": "أستطيع أن أقرأ ä و ö و ü و ß وأنطقها وأميّزها من a و o و u و s."
      },
      {
        "de": "Ich kann die Vokale e und i sowie o und u beim Hören und Lesen sicher unterscheiden.",
        "tr": "Dinlerken ve okurken e ile i’yi, o ile u’yu güvenle ayırt edebilirim.",
        "ar": "أستطيع أن أميّز بثقة بين e و i وبين o و u عند الاستماع والقراءة."
      },
      {
        "de": "Ich kann p und b hören und schreiben und weiß, wie f, v und w ausgesprochen werden.",
        "tr": "p ve b seslerini duyup yazabilir, f, v ve w harflerinin nasıl okunduğunu bilirim.",
        "ar": "أستطيع أن أسمع p و b وأكتبهما، وأعرف كيف تُنطق f و v و w."
      },
      {
        "de": "Ich kann häufige Buchstabenverbindungen lesen, kurze Wörter vorlesen und meinen Namen in Lateinschrift schreiben.",
        "tr": "Sık geçen harf gruplarını okuyabilir, kısa kelimeleri sesli okuyabilir ve adımı Latin harfleriyle yazabilirim.",
        "ar": "أستطيع أن أقرأ مجموعات الحروف الشائعة، وأن أقرأ كلمات قصيرة بصوت عالٍ، وأن أكتب اسمي بالحروف اللاتينية."
      }
    ],
    "nurFuerAusgang": "ar",
    "kinderGeeignet": true
  },
