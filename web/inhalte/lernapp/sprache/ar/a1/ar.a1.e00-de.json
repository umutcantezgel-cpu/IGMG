    "thema": {
      "de": "Vorkurs: Schrift und Lesezeichen",
      "tr": "Ön kurs: Yazı ve okuma işaretleri",
      "ar": "دورة تمهيدية: الخط والحركات"
    },
    "kannBeschreibungen": [
      {
        "de": "Ich kann von rechts nach links lesen und 14 Buchstaben an Grundform und Punkten erkennen.",
        "tr": "Sağdan sola okuyabilir, 14 harfi temel biçiminden ve noktalarından tanıyabilirim.",
        "ar": "أستطيع أن أقرأ من اليمين إلى اليسار، وأن أتعرف على أربعة عشر حرفًا من شكلها ونقاطها."
      },
      {
        "de": "Ich kann alle 28 Buchstaben und die Hamza erkennen und Laute unterscheiden, die es im Deutschen und Türkischen nicht gibt.",
        "tr": "28 harfin hepsini ve hemzeyi tanıyabilir, Almancada ve Türkçede olmayan sesleri ayırt edebilirim.",
        "ar": "أستطيع أن أتعرف على الحروف الثمانية والعشرين وعلى الهمزة، وأن أميز أصواتًا لا توجد في الألمانية والتركية."
      },
      {
        "de": "Ich kann die Formen eines Buchstabens am Anfang, in der Mitte und am Ende erkennen und Wörter in Buchstaben zerlegen.",
        "tr": "Bir harfin başta, ortada ve sondaki biçimlerini tanıyabilir, kelimeleri harflerine ayırabilirim.",
        "ar": "أستطيع أن أتعرف على أشكال الحرف في أول الكلمة ووسطها وآخرها، وأن أحلل الكلمات إلى حروفها."
      },
      {
        "de": "Ich kann Fatḥa, Kasra und Ḍamma lesen und Silben und kurze Wörter laut lesen.",
        "tr": "Fatḥa, Kasra ve Ḍamma işaretlerini okuyabilir, heceleri ve kısa kelimeleri sesli okuyabilirim.",
        "ar": "أستطيع أن أقرأ الفتحة والكسرة والضمة، وأن أقرأ المقاطع والكلمات القصيرة بصوت عال."
      },
      {
        "de": "Ich kann lange und kurze Vokale unterscheiden und die Doppellaute ay und aw lesen.",
        "tr": "Uzun ve kısa ünlüleri ayırt edebilir, ay ve aw çift ünlülerini okuyabilirim.",
        "ar": "أستطيع أن أميز بين الحركات الطويلة والقصيرة، وأن أقرأ حرفي اللين كما في «بيت» و«يوم»."
      },
      {
        "de": "Ich kann vokallose und verdoppelte Konsonanten lesen und hören.",
        "tr": "Ünlüsüz ve ikilenmiş ünsüzleri okuyabilir ve duyabilirim.",
        "ar": "أستطيع أن أقرأ الحروف الساكنة والمشددة وأن أميزها بالسمع."
      },
      {
        "de": "Ich kann Tanwīn lesen, die Tāʾ marbūṭa richtig aussprechen und am Satzende in Pausa sprechen.",
        "tr": "Tenvini okuyabilir, tāʾ marbūṭayı doğru söyleyebilir ve cümle sonunda vakf yapabilirim.",
        "ar": "أستطيع أن أقرأ التنوين، وأن أنطق التاء المربوطة نطقًا صحيحًا، وأن أقف على آخر الجملة."
      },
      {
        "de": "Ich kann die Grundregeln der Hamza anwenden und den Artikel vor Sonnen- und Mondbuchstaben richtig lesen.",
        "tr": "Hemzenin temel kurallarını uygulayabilir, al- takısını güneş ve ay harflerinden önce doğru okuyabilirim.",
        "ar": "أستطيع أن أطبق القواعد الأساسية للهمزة، وأن أقرأ أل التعريف مع الحروف الشمسية والقمرية قراءة صحيحة."
      }
    ],
    "nurFuerAusgang": "de",
    "kinderGeeignet": true
  },
