      "lizenz": "CC-BY-SA-4.0"
    },
    {
      "schluessel": "ar.a1.e00-de.s0047",
      "text": "الشَّمْسُ فِي السَّمَاءِ.",
      "quelle": "ki:lernapp-inhalte/a1/v1",
      "lizenz": "CC-BY-SA-4.0"
    },
    {
      "schluessel": "ar.a1.e00-de.s0048",
      "text": "الْكِتَابُ فِي الْغُرْفَةِ.",
      "quelle": "ki:lernapp-inhalte/a1/v1",
      "lizenz": "CC-BY-SA-4.0"
    },
    {
      "schluessel": "ar.a1.e00-de.s0049",
      "text": "الْقَمَرُ فِي السَّمَاءِ.",
      "quelle": "ki:lernapp-inhalte/a1/v1",
      "lizenz": "CC-BY-SA-4.0"
    },
    {
      "schluessel": "ar.a1.e00-de.s0050",
      "text": "الْبَابُ كَبِيرٌ وَجَدِيدٌ.",
      "quelle": "ki:lernapp-inhalte/a1/v1",
      "lizenz": "CC-BY-SA-4.0"
    }
