      "quelle": "ki:lernapp-inhalte/a1/v1",
      "lizenz": "CC-BY-SA-4.0"
    },
    {
      "schluessel": "ar.a1.e00-de.s0046",
      "text": "الْأُمُّ وَالْوَلَدُ فِي الْبَيْتِ.",
