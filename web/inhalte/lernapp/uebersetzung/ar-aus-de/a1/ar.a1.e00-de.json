  "tipps": [
    {
      "schluessel": "ar.a1.e00-de.de.t01",
      "titel": "Von rechts nach links",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Arabisch liest und schreibt man von rechts nach links; Hefte und Bücher beginnen deshalb aus deutscher Sicht „hinten“."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Lies von rechts: bāb (Tür), bayt (Haus)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "بَابٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "بَيْتٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t02",
      "titel": "Punkte entscheiden",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "bāʾ, tāʾ, ṯāʾ, nūn und yāʾ haben dieselbe Grundform; nur Zahl und Lage der Punkte unterscheiden sie."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Groß- und Kleinbuchstaben gibt es nicht."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "ب ت ث ن ي"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t03",
      "titel": "ḫ, ǧ, ṯ und ḏ",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ḫ klingt wie ch in „Bach“ (ḫubz, Brot), ǧ wie dsch in „Dschungel“ (ǧadīd, neu)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ṯ und ḏ sprichst du wie englisch th in „think“ und „this“."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "خُبْزٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "جَدِيدٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t04",
      "titel": "Kehllaute: ḥ und ʿayn",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ḥ ist ein stark gehauchtes h aus dem Rachen, ʿayn ein gepresster Kehllaut."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ʿayn ist kein Vokal: ʿamal (Arbeit) und amal (Hoffnung) sind verschiedene Wörter."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "عَمَلٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "أَمَلٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t05",
      "titel": "q sitzt weiter hinten als k",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "q sprichst du ganz hinten im Rachen, k wie im Deutschen: qāla (er hat gesagt), kāla (er hat abgemessen)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ġ klingt ähnlich wie das deutsche Zäpfchen-r; das arabische r rollst du mit der Zungenspitze."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "قَالَ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كَالَ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t06",
      "titel": "Dunkle Laute: ṣ, ḍ, ṭ, ẓ",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ṣ, ḍ, ṭ und ẓ sind dunkle Partner von s, d, t und z; der Vokal daneben klingt dunkler."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "saʿīd heißt „glücklich“, ṣaʿīd „Hochebene“."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "سَعِيدٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "صَعِيدٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t07",
      "titel": "Vier Formen, sechs Ausnahmen",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Die meisten Buchstaben haben vier Formen: allein, am Anfang, in der Mitte und am Ende; der Kern bleibt erkennbar."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "alif, dāl, ḏāl, rāʾ, zāy und wāw verbinden sich nicht nach links – danach beginnt eine neue Gruppe im Wort."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "وَلَدٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَدْرَسَةٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t08",
      "titel": "lām-alif und besondere Wortenden",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "lām und alif bilden zusammen ein eigenes Zeichen, zum Beispiel in lā (nein)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Am Wortende stehen oft die Tāʾ marbūṭa (madrasa) und die Alif maqṣūra, eine yāʾ ohne Punkte (ʿalā, auf)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "لَا"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَدْرَسَةٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "عَلَى"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t09",
      "titel": "Kurze Vokale über und unter dem Buchstaben",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Fatḥa (a) ist ein Strich über dem Buchstaben, Kasra (i) ein Strich darunter, Ḍamma (u) ein kleines wāw darüber."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "So liest du kataba (er hat geschrieben) und darasa (er hat gelernt)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "بَ بِ بُ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كَتَبَ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "دَرَسَ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t10",
      "titel": "Im Kurs mit Vokalzeichen, im Alltag ohne",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Zeitungen, Schilder und Bücher lassen die kurzen Vokale meist weg; im Kurs ist jeder Text voll vokalisiert."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Neben ṣ, ḍ, ṭ, ẓ und q klingt a dunkler."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كَتَبَ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كتب"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t11",
      "titel": "Lang und kurz unterscheiden Wörter",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "alif, wāw und yāʾ zeigen lange Vokale: ā, ū, ī. Sprich sie etwa doppelt so lang wie kurze Vokale."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Sonst entsteht ein anderes Wort: maṭar (Regen), maṭār (Flughafen); kataba (er hat geschrieben), kātaba (er hat Briefe gewechselt)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَطَرٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَطَارٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كَاتَبَ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t12",
      "titel": "ay und aw",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Die Doppellaute ay und aw klingen ähnlich wie „ei“ und „au“."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Sprich sie nicht als langes e oder o: bayt (Haus), yawm (Tag)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "بَيْتٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "يَوْمٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t13",
      "titel": "Sukūn: Silbe ohne Vokal",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Der kleine Kreis über einem Buchstaben heißt Sukūn: Hier folgt kein Vokal, die Silbe ist zu Ende."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Schiebe keinen Hilfsvokal ein: baḥr (Meer), maktab (Büro)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "بَحْرٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَكْتَبٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t14",
      "titel": "Šadda: den Konsonanten lang sprechen",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Šadda verdoppelt den Konsonanten: Halte ihn hörbar länger. Ein deutscher Doppelbuchstabe zeigt dagegen nur einen kurzen Vokal davor."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "madrasa heißt „Schule“, mudarris „Lehrer“."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مَدْرَسَةٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "مُدَرِّسٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t15",
      "titel": "Tanwīn und Pausa",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Doppelte Vokalzeichen am Wortende heißen Tanwīn und klingen wie -un, -an, -in."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Am Satzende fällt die kurze Endung weg (Pausa): kitābun wird zu kitāb."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كِتَابٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كِتَابًا"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "كِتَابٍ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t16",
      "titel": "Tāʾ marbūṭa: -a oder -at",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Die Tāʾ marbūṭa sieht aus wie ein hāʾ mit zwei Punkten."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Am Satzende sprichst du nur -a, im Satz -at mit der Endung: ġurfa, ġurfatun (Zimmer)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "غُرْفَةٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "سَيَّارَةٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t17",
      "titel": "Ziffern von links nach rechts",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Viele arabische Länder schreiben östlich-arabische Ziffern; Zahlen liest man auch im arabischen Text von links nach rechts."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Die Fünf sieht aus wie eine Null, die Null ist ein Punkt."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "٠ ١ ٢ ٣ ٤ ٥ ٦ ٧ ٨ ٩"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "١٥"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t18",
      "titel": "Hamza: der Knacklaut",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Hamza ist der Knacklaut wie in „be-achten“ – im Arabischen auch mitten im Wort und am Ende."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Sie sitzt auf alif, wāw oder yāʾ oder steht allein auf der Zeile: arḍ (Erde), suʾāl (Frage), samāʾ (Himmel)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "أَرْضٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "سُؤَالٌ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "سَمَاءٌ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t19",
      "titel": "Sonnenbuchstaben: Das l wird zum nächsten Laut",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Vor Mondbuchstaben hörst du das l des Artikels: al-qamar (der Mond)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Vor den Sonnenbuchstaben t, ṯ, d, ḏ, r, z, s, š, ṣ, ḍ, ṭ, ẓ, l und n klingt es wie der nächste Laut, der verdoppelt wird: aš-šams (die Sonne)."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "الْقَمَرُ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "الشَّمْسُ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "النَّافِذَةُ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "ar.a1.e00-de.de.t20",
      "titel": "Kein Knacklaut vor al- im Satz",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Nach einem Vokal fällt das a von al- weg, und die Wörter werden verbunden: fī l-bayt (im Haus), wa-l-walad (und der Junge)."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "In der Umschrift ist z ein summendes s wie in „Rose“, nicht „ts“."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "فِي الْبَيْتِ"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "وَالْوَلَدُ"
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    }
  ]
}
