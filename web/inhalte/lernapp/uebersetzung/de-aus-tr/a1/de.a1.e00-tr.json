      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "de.a1.e00-tr.tr.t02",
      "titel": "ß ve ss: sert s",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ß tek bir harftir ve sert bir s gibi okunur."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Uzun ünlüden sonra ß, kısa ünlüden sonra ss yazılır. Klavyende ß yoksa ss yazabilirsin."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "die Straße"
