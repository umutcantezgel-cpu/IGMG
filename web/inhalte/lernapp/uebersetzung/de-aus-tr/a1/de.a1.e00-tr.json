      "titel": "sch = ş, tsch = ç, j = y",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Almancada ş ve ç harfleri yoktur: ş sesi sch, ç sesi tsch ile yazılır."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "j harfi Türkçedeki y gibi okunur."
