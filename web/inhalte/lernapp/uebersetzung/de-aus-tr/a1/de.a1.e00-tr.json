      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "de.a1.e00-tr.tr.t03",
      "titel": "Bütün isimler büyük harfle",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Türkçede yalnızca özel isimler ve cümle başı büyük harfle yazılır."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Almancada her isim büyük harfle başlar: eşya, kişi ve yer adları, cümlenin neresinde olursa olsun."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "der Tisch"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "die Schule"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Ich trinke Tee."
                  }
                ]
              }
            ]
          }
        ]
      },
      "quelle": "ki:lernapp-inhalte/a1/v1"
    },
    {
      "schluessel": "de.a1.e00-tr.tr.t04",
      "titel": "z = ts, s = z",
