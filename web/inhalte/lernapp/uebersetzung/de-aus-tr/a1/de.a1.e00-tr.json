    {
      "schluessel": "de.a1.e00-tr.tr.t06",
      "titel": "Büyük I noktasızdır, ı yoktur",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Almancada noktasız ı yoktur."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Küçük i’nin büyüğü noktasız I’dır ve Türkçedeki İ gibi okunur. Türkçe klavyede yazarken dikkat et."
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
