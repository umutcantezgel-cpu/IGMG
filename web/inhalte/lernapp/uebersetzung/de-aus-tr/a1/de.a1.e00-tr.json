    {
      "schluessel": "de.a1.e00-tr.tr.t01",
      "titel": "ä yeni: açık bir e",
      "inhalt": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ö ve ü Türkçedeki gibi okunur."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "ä ise yeni bir harf: açık bir e gibi okunur. Çoğu zaman a’lı bir kelimeden gelir."
              }
