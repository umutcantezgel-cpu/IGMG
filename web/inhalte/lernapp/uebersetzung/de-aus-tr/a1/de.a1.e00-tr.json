        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Almancada z harfi ts gibi okunur."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Ünlüden önce gelen s ise çoğunlukla Türkçedeki z gibi okunur."
