# Vorlage für .env (lokal) bzw. Umgebungsvariablen im Betrieb. Echte Werte NIE ins Repository (G-03).
# Nur Öffentliches trägt das Präfix NEXT_PUBLIC_ (hier: keines).

# Allgemein
APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Datenbank: PostgreSQL (docker compose) oder leer lassen für PGlite (nur Entwicklung/Tests)
DATABASE_URL=postgres://igmg:igmg-lokal@localhost:5432/igmg
PGLITE_VERZEICHNIS=.pglite

# Anmeldung (Better Auth): mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Verschlüsselung der Formulareingänge (32 Byte Base64, `openssl rand -base64 32`), Schlüssel-ID für Rotation
EINGANG_SCHLUESSEL=
EINGANG_SCHLUESSEL_ID=1

# Ratenbegrenzung: Geheimnis für den IP-Hash (`openssl rand -base64 32`)
RATE_GEHEIMNIS=

# ALTCHA: HMAC-Geheimnis für Challenges (`openssl rand -base64 32`)
ALTCHA_GEHEIMNIS=

# Wartungsroute (Löschfristen, per Cron): langes zufälliges Token
WARTUNG_TOKEN=

# E-Mail: smtp (Mailpit lokal: localhost:1025) oder datei (schreibt .eml nach .mail/)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_ABSENDER="IGMG Wetzlar <noreply@example.test>"

# Medien: dateisystem (Standard) oder s3
SPEICHER=dateisystem
MEDIEN_VERZEICHNIS=.medien
S3_ENDPUNKT=
S3_REGION=
S3_BUCKET=
S3_ZUGANG=
S3_GEHEIMNIS=
