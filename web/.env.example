# Vorlage für .env (lokal) bzw. Umgebungsvariablen im Betrieb. Echte Werte NIE ins Repository (G-03).
# Nur Öffentliches trägt das Präfix NEXT_PUBLIC_ (hier: keines).
# Geheimnisse erzeugt `pnpm geheimnisse:erzeugen` (Anleitung: docs/BETRIEB.md 9); diese Vorlage enthält keine echten Werte.
# Auf Vercel setzt Vercel VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL und VERCEL_PROJECT_PRODUCTION_URL selbst:
# diese Variablen nie eintragen.

# Allgemein
APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Betriebsart: entwicklung | vorschau | produktion. Leer lassen: abgeleitet aus VERCEL_ENV bzw. NODE_ENV
# (lokal entwicklung, Docker-Image produktion). Auf Vercel je Bereich setzen: Vorschau = vorschau, Produktion = produktion.
SITE_MODE=

# Datenbank: PostgreSQL (docker compose) oder leer lassen für PGlite (nur Entwicklung/Tests)
DATABASE_URL=postgres://igmg:igmg-lokal@localhost:5432/igmg
PGLITE_VERZEICHNIS=.pglite

# Anmeldung (Better Auth): mindestens 32 zufällige Zeichen, z. B. `pnpm geheimnisse:erzeugen`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Verschlüsselung der Formulareingänge (32 Byte Base64, `pnpm geheimnisse:erzeugen`), Schlüssel-ID für Rotation
EINGANG_SCHLUESSEL=
EINGANG_SCHLUESSEL_ID=1

# Ratenbegrenzung: Geheimnis für den IP-Hash (`pnpm geheimnisse:erzeugen`)
RATE_GEHEIMNIS=

# ALTCHA: HMAC-Geheimnis für Challenges (`pnpm geheimnisse:erzeugen`)
ALTCHA_GEHEIMNIS=

# Wartungsrouten (Cache-Erneuerung beim Start, Löschfristen per Cron): zufälliges Token, mind. 32 Zeichen
# (`pnpm geheimnisse:erzeugen`)
WARTUNG_TOKEN=

# Vercel Cron: Schutz der Cron-Aufrufe per Bearer-Token, nur für Produktion (`pnpm geheimnisse:erzeugen`)
CRON_SECRET=

# Vercel Blob: setzt Vercel selbst, sobald der Blob-Speicher mit dem Projekt verbunden ist. Lokal leer lassen.
BLOB_READ_WRITE_TOKEN=

# Beim Start alle Inhalts-Caches verfallen lassen (ADR 0017; im Docker-Image gesetzt)
CACHE_ERNEUERN_BEIM_START=0

# E-Mail: smtp (Mailpit lokal: localhost:1025) oder datei (schreibt .eml nach .mail/, nur lokal)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_ABSENDER="IGMG Wetzlar <noreply@example.test>"

# Medien: dateisystem (Standard, Docker und lokal) oder s3. Auf Vercel ist das Dateisystem schreibgeschützt: dort s3.
# Künftig auch blob (Vercel Blob, noch nicht in der App angebunden). Fehlt die Variable, gilt dateisystem.
SPEICHER=dateisystem
MEDIEN_VERZEICHNIS=.medien
S3_ENDPUNKT=
S3_REGION=
S3_BUCKET=
S3_ZUGANG=
S3_GEHEIMNIS=

# Vertrauter Proxy (E-041): nur auf 1 setzen, wenn ein TLS-Proxy davor X-Real-IP setzt bzw. X-Forwarded-For anhängt.
# Ohne Proxy (0) teilen sich alle Besucher ein Limit – die Adresse lässt sich sonst fälschen.
# Auf Vercel 1 (Vercel setzt X-Forwarded-For selbst).
PROXY_VERTRAUEN=0

# Nur bei Bedarf (im Docker-Image gesetzt; auf Vercel nicht setzen, BETRIEB.md 9):
# MIGRATION_BEIM_START=1
# MIGRATIONEN_VERZEICHNIS=/app/drizzle/migrations
# PORT=3000
# HOSTNAME=0.0.0.0
# Schlüsselrotation: den bisherigen Eingangsschlüssel als EINGANG_SCHLUESSEL_ALT_<ID> eintragen (ID = alte EINGANG_SCHLUESSEL_ID)
