# Vorlage für .env auf dem lokalen Server (ADR 0036). Echte Werte nur auf dem Server, nie ins Repository.

# Öffentliche Adresse der Website (wie APP_URL bei Vercel)
APP_URL=https://<domain der Gemeinde>
# Gleiches Token wie WARTUNG_TOKEN bei Vercel (mind. 32 Zeichen) – öffnet Takt, Mail-Ausgang und Meldungen ans Cockpit
WARTUNG_TOKEN=<aus pnpm geheimnisse:erzeugen>

# Sicherung: Lese-Zugang zur Neon-Datenbank (eigene Rolle nur mit SELECT, BETRIEB.md) und öffentlicher age-Schlüssel
SICHERUNG_DATABASE_URL=postgresql://<leserolle>:<passwort>@<host>/<db>?sslmode=require
AGE_EMPFAENGER=age1<öffentlicher Schlüssel des Vorstands>
# Privater age-Schlüssel nur für die monatliche Wiederherstellungsprobe (Datei ./schluessel/probe.key, Modus 600)
SICHERUNG_TAGE=30

# Medienspiegel: Lesetoken des Vercel-Blob-Speichers (nur lesen; neues Token in Vercel anlegen)
BLOB_READ_WRITE_TOKEN=<vercel blob token>

# Überwachung: Mail an die Technik bei Ausfall (SMTP des Mailanbieters)
TECHNIK_MAIL=technik@<domain der Gemeinde>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<benutzer>
SMTP_PASS=<passwort>
MAIL_ABSENDER=igmg-server@<domain der Gemeinde>

# Echtzeit (Profil echtzeit, nur mit öffentlicher Adresse und DynDNS, MN-12)
ECHTZEIT_DOMAIN=echtzeit.<domain der Gemeinde>
# Centrifugo liest seine Einstellungen aus diesen Variablen (überschreiben echtzeit/centrifugo.json)
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=<gleich ECHTZEIT_GEHEIMNIS bei Vercel, mind. 32 Zeichen>
CENTRIFUGO_HTTP_API_KEY=<gleich ECHTZEIT_API_SCHLUESSEL bei Vercel>
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://<domain der Gemeinde>
